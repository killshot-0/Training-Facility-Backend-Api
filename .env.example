# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings


NODE_ENV=development
DATABASE_URL="postgresql://usernam:password@localhost:5432/mydb?schema=public"
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=some-long-random-secret

COOKIE_SECRET=some-long-random-secret

GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_STORAGE_BUCKET=carepoint-assets

# Mailtrap SMTP (Development)
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your-mailtrap-user"
SMTP_PASS="your-mailtrap-password"

# Resend API (Production)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="CarePoint Clinic <appointments@carepoint-clinic.com>"

# OpenRouter
OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=provider/model-name-from-the-catalog